{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cut-ties-api",
  "main": "src/index.ts",
  "compatibility_date": "2025-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // §7.2 weekly digest (worker/src/digest.ts): Mondays 09:00 UTC.
  "triggers": { "crons": ["0 9 * * 1"] },
  // Cloudflare Email Routing. Enable Email Routing on the zone and add MAINTAINER_EMAIL as a
  // verified destination; DIGEST_FROM must be an address on the zone. MAINTAINER_EMAIL is a Worker
  // secret (`npx wrangler secret put MAINTAINER_EMAIL`), not a var, so the address stays out of git.
  "send_email": [{ "name": "DIGEST_MAIL" }],
  // Production: `npm run deploy` renders wrangler.deploy.json (gitignored) from this file with the
  // real D1 id from $D1_DATABASE_ID and, when $SITE_DOMAIN is set, a `<domain>/api/*` route
  // (scripts/render-deploy-config.ts, docs/specs/deployment.md). Wrangler cannot read env vars
  // from this file, so the id never lives in git and local dev keeps the placeholder below.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cut_ties",
      // Placeholder for local dev and tests; production id comes from $D1_DATABASE_ID at deploy time.
      "database_id": "00000000-0000-0000-0000-000000000000"
    }
  ],
  "vars": {
    "MAX_GENERATIONS_PER_DAY": "500",
    "LLM_MONTHLY_BUDGET_USD": "15",
    "STRIPE_LINKS": "{}",
    "DIGEST_FROM": "digest@cutthetiesmovement.org",
    "COUNT_THRESHOLD": "5",
    "VISITS_ENABLED": "1",
    // Geocoder vintage: ACS2025_Current = the 119th map the sitting members hold. Flip to
    // Current_Current on 2027-01-03 with ACTIVE_CONGRESS (docs/prd/district-flip-2027.md §1).
    "DISTRICT_VINTAGE": "ACS2025_Current"
    // Secrets (wrangler secret put): TURNSTILE_SECRET, ANTHROPIC_API_KEY, IP_SALT, VISITS_REVIEW_SECRET.
    // Without TURNSTILE_SECRET the route endpoint skips the Turnstile check (local dev only).
  }
}
