---
import '../styles/global.css';
interface Props { title: string; description?: string; image?: string }
const { title, description = 'Enter your address. We find the people who represent you in Congress and the two things you can do this week to cut US military ties with Israel.', image } = Astro.props;
const abs = (path: string) => (Astro.site ? new URL(path, Astro.site).href : path);
const pageUrl = abs(Astro.url.pathname);
const imageUrl = abs(image ?? '/card.png');
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#090A0F" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Inter:wght@400;600&family=Space+Mono:wght@700&display=swap" rel="stylesheet" />
  </head>
  <body class="min-h-screen flex flex-col selection:bg-acid selection:text-ink">
    <header class="border-b-2 border-ink bg-newsprint">
      <div class="mx-auto max-w-[1360px] px-4 lg:px-10 h-14 flex items-center justify-between">
        <a href="/" class="flex items-center gap-2.5">
          <img src="/mark-96.png" width="48" height="48" alt="" class="-my-1" />
          <span class="font-condensed text-2xl tracking-wider uppercase leading-none">Cut the Ties</span>
          <span class="label-ticker hidden sm:inline">Constituent action</span>
        </a>
        <nav class="flex items-center gap-4">
          <a href="/goals" class="label-code hover:underline">All goals</a>
          <a href="/donate" class="btn btn-primary !py-2 !px-3 text-xs">Donate</a>
        </nav>
      </div>
    </header>
    <main class="flex-1">
      <slot />
    </main>
    <footer class="bg-ink text-newsprint border-t-2 border-ink mt-10">
      <div class="mx-auto max-w-[1360px] px-4 lg:px-10 py-8 flex flex-col md:flex-row md:items-center md:justify-between gap-4">
        <p class="font-condensed uppercase tracking-wide text-2xl leading-none">
          Built and paid for by one person; donations keep it up.
          <a href="/donate" class="underline decoration-acid decoration-2 underline-offset-4 hover:text-acid">Donate</a>
        </p>
        <nav class="flex gap-5 label-ticker">
          <a href="/about" class="hover:text-acid">About</a>
          <a href="/privacy" class="hover:text-acid">Privacy</a>
          <a href="/goals" class="hover:text-acid">All goals</a>
        </nav>
      </div>
    </footer>
  </body>
</html>
