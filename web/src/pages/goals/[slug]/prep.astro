---
import { getImage } from 'astro:assets';
import Base from '../../../layouts/Base.astro';
import Photo from '../../../components/Photo.astro';
import PrepAction from '../../../components/PrepAction';
import { actionsFor, CATEGORY, fmtDate, picks, prepGoals, prepHtml, prepSections, sources, unifiedAsk, type Goal } from '../../../lib/goals';
import { HERO, PHOTO_OUTPUT, heroWidths, imageFor, imageIdFor } from '../../../lib/images';
export function getStaticPaths() {
  return prepGoals().map((g) => ({ params: { slug: g.slug }, props: { goal: g } }));
}
const { goal } = Astro.props as { goal: Goal };
const open = goal.status === 'active';
// site-imagery §3.2: the hero photo is the goal's image and the LCP element, so the head preloads the AVIF files the
// hero `Photo` below asks for (same file, widths and sizes).
const heroFile = imageFor(goal);
const heroW = heroWidths(heroFile.width);
const heroPreload = await getImage({ src: heroFile, format: 'avif', widths: heroW, quality: PHOTO_OUTPUT.quality });
const sections = prepSections(goal.prep_md);
const ranked = picks(goal).slice(0, 3);
const leadership = goal.category === 'leadership';
const pickDate = ranked.map((p) => p.signal_date ?? '').sort().pop() || null;
const ask = unifiedAsk(goal.what_we_want, ranked[0]?.name);
const srcs = sources(goal);
const verbs: Record<string, string> = { call: 'Get my call script', letter: 'Write my letter' };
const actions = open ? actionsFor(goal).map((a) => ({ slug: a.slug, label: verbs[a.type] ?? 'Comment' })) : [];
---
<Base title={`Prep: ${goal.title} — Cut the Ties`} description={`What to know and what to say: ${goal.summary}`} image={`/goals/${goal.slug}/card.png`}>
  <link slot="head" rel="preload" as="image" type="image/avif" imagesrcset={heroPreload.srcSet.attribute} imagesizes={HERO.sizes} fetchpriority="high" />
  <section class="relative hero-gradient text-newsprint overflow-hidden">
    <div class="absolute inset-0 halftone pointer-events-none"></div>
    <Photo id={imageIdFor(goal)} widths={heroW} sizes={HERO.sizes} eager class="hero-photo" />
    <div class="relative mx-auto max-w-[1360px] px-4 lg:px-10 py-12 lg:py-16">
      <div class="flex gap-2 mb-4">
        <span class="chip bg-hazard text-ink border-ink">{CATEGORY[goal.category]}</span>
        <span class="chip bg-newsprint text-ink border-ink">Prep</span>
      </div>
      <h1 class="display-lg max-w-4xl">{goal.title}</h1>
      <p class="mt-5 text-lg max-w-2xl">{goal.summary}</p>
      <p class="mt-4 label-code text-hazard">Decision: {fmtDate(goal.decision_date) ?? 'not yet scheduled'}</p>
      <div class="mt-6 flex flex-wrap gap-3">
        {actions.length > 0 && <a href="#take-action" class="btn btn-primary">Take action →</a>}
        <a href={`/goals/${goal.slug}`} class="btn bg-newsprint text-ink hover:bg-paper">About this goal</a>
      </div>
    </div>
  </section>

  <div class="mx-auto max-w-[1360px] px-4 lg:px-10 py-10 grid grid-cols-1 lg:grid-cols-[minmax(0,2fr)_minmax(0,1fr)] gap-8 lg:gap-12">
    <div class="flex flex-col gap-10">
      {leadership && (
        <section aria-labelledby="picks">
          <p class="label-code">Our picks</p>
          <h2 id="picks" class="headline-lg mt-1">{ranked.length > 0 ? 'Who we would back instead' : 'Our picks are not set yet'}</h2>
          {ranked.length > 0 ? (
            <>
              <ol class="mt-4 flex flex-col gap-3 max-w-2xl">
                {ranked.map((p, i) => (
                  <li class="card p-5">
                    <p class="label-code">Pick {i + 1}</p>
                    <h3 class="headline-md mt-1">{p.name}</h3>
                    <p class="mt-3">{p.rationale}</p>
                    <p class="mt-3 label-ticker">
                      <a href={p.source_url} rel="noopener" class="underline">Source</a>
                      {p.signal ? ` · ${p.signal}` : ''}{p.signal_date ? ` · ${fmtDate(p.signal_date)}` : ''}
                    </p>
                  </li>
                ))}
              </ol>
              <p class="mt-3 label-ticker text-ink/70">Picks chosen by hand from sourced reporting{pickDate ? `, as of ${fmtDate(pickDate)}` : ''}. Nothing here is counted by a model.</p>
            </>
          ) : (
            <p class="mt-3 max-w-2xl">We have not finished checking who has said they want the job and where they stand, so we are not naming anyone yet. The ask below works without a name.</p>
          )}
        </section>
      )}
      {leadership && (
        <section class="card-lg p-5 lg:p-6 bg-acid" aria-labelledby="ask">
          <p class="label-code">What to ask for, in one line</p>
          <h2 id="ask" class="headline-lg mt-1">{ask}</h2>
        </section>
      )}

      {sections.map((s, i) => (
        <section id={s.id} aria-labelledby={`${s.id}-h`}>
          <p class="label-code">{String(i + 1).padStart(2, '0')}</p>
          <h2 id={`${s.id}-h`} class="headline-lg mt-1">{s.title}</h2>
          <div class="prose-cut mt-4 max-w-2xl" set:html={prepHtml(s.body)} />
          {s.id === 'sources' && srcs.length > 0 && (
            <ul class="mt-4 flex flex-col gap-1 text-sm">{srcs.map((x) => <li><a href={x.url} rel="noopener" class="underline">{x.title}</a></li>)}</ul>
          )}
        </section>
      ))}
    </div>

    <aside class="flex flex-col gap-8">
      {actions.length > 0 && (
        <section id="take-action" aria-labelledby="take-action-h">
          <p class="label-code">Make the call</p>
          <h2 id="take-action-h" class="headline-md mt-1 mb-3">Get your script</h2>
          <PrepAction client:load slug={goal.slug} actions={actions} />
        </section>
      )}
      <p><a href={`/goals/${goal.slug}`} class="label-code underline underline-offset-4">About this goal →</a></p>
      <p><a href="/goals" class="label-code underline underline-offset-4">All goals →</a></p>
    </aside>
  </div>
</Base>

<style>
  /* site-imagery §3.2: below 1024 px the hero text runs the full width, over the lightest side of the photo, so the
     loaded photo is dimmed there (the landing does the same below 768 px). */
  @media (max-width: 1023px) {
    :global(.hero-photo) { filter: brightness(0.75); }
  }
</style>
