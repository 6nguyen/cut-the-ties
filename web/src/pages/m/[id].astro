---
import Base from '../../layouts/Base.astro';
import { fmtDate } from '../../lib/goals';
import { contactLabel, goalsFor, members, officesFor, PARTY, positionLine, role, seat, type Member } from '../../lib/members';
import Offices from '../../components/Offices.astro';
import MemberContact from '../../components/MemberContact';
import Counts from '../../components/Counts';
import Visits from '../../components/Visits';
import { PARTY_CLASS, portraitSrc } from '../../components/Target';
import { TREATMENT, hasPortraitFile } from '../../lib/images';
// One static page per sitting member; unknown ids fall through to the 404 page.
export function getStaticPaths() {
  return members().map((m) => ({ params: { id: m.bioguide_id }, props: { member: m } }));
}
const { member: m } = Astro.props as { member: Member };
// site-imagery §4.3: a member the import found no portrait for gets no slot and no gap.
const portrait = hasPortraitFile(m.bioguide_id);
const goals = goalsFor(m);
const first = goals[0];
const title = first ? `${m.name} on ${first.goal.title}` : `${role(m)} ${m.name}`;
const siteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY as string | undefined;
const partner = goals.find((g) => g.goal.partner_url)?.goal.partner_url ?? null;
// tap-receipts-everywhere §4: the hero's buttons are one island; a tap counts toward the first open goal with an action.
const contact = { bioguide_id: m.bioguide_id, name: m.name, role: role(m), party: m.party, chamber: m.chamber, state: m.state, district: m.district, dc_phone: m.dc_phone, district_phone: m.district_phone, contact_form_url: m.contact_form_url, contact_kind: m.contact_kind, contact_label: contactLabel(m) };
const receiptGoal = first?.action ? { slug: first.goal.slug, title: first.goal.title, what_we_want: first.goal.what_we_want, category: first.goal.category, action: first.action.slug } : null;
const POS: Record<string, string> = { for: 'bg-acid text-ink', uncommitted: 'bg-hazard text-ink', against: 'bg-crimson text-paper', unknown: 'bg-newsprint-muted text-ink' };
---
<Base title={`${title} — Cut the Ties`} description={positionLine(m, first)} image={`/m/${m.bioguide_id}/card.png`}>
  <section class="relative hero-gradient text-newsprint overflow-hidden" data-member data-state={m.state} data-district={m.chamber === 'house' ? m.district : ''} data-chamber={m.chamber}>
    <div class="absolute inset-0 halftone pointer-events-none"></div>
    <div class="relative mx-auto max-w-[1360px] px-4 lg:px-10 py-12 lg:py-16">
      <div class="sm:flex sm:items-start sm:gap-6" data-member-head>
        {portrait && (
          <span class={`portrait w-[120px] h-[150px] mb-5 sm:mb-0 border-2 border-newsprint font-condensed text-[64px] ${PARTY_CLASS(m.party)}`} data-portrait={m.bioguide_id}>
            <span aria-hidden="true">{m.party}</span>
            <img src={portraitSrc(m.bioguide_id)} alt="" width="120" height="150" decoding="async" style={`filter:contrast(${TREATMENT.contrast})`} onload="this.parentNode.dataset.loaded='1'" />
          </span>
        )}
        <div class="min-w-0">
      <div class="flex flex-wrap gap-2 mb-4">
        <span class="chip bg-hazard text-ink border-ink">{PARTY[m.party]} · {seat(m)}</span>
        <span class="chip bg-newsprint text-ink border-ink">{m.chamber === 'house' ? 'House' : 'Senate'}</span>
        <span class="chip bg-acid text-ink border-ink hidden" data-yours>Your representative</span>
      </div>
      <h1 class="display-lg max-w-4xl">{role(m)} {m.name} <span data-postmark-slot class="inline-block align-middle ml-2"></span></h1>
      <p class="mt-5 text-lg max-w-2xl">{m.state}{m.chamber === 'house' ? ` · District ${m.district === 0 ? 'at large' : m.district}` : ' · Senator'} · {PARTY[m.party]}</p>
        </div>
      </div>
      <MemberContact client:load member={contact} goal={receiptGoal} />
      {m.district_office_address && <p class="mt-4 text-sm label-ticker" data-office>District office: {m.district_office_address}{m.district_office_city ? `, ${m.district_office_city}` : ''}</p>}
    </div>
  </section>
  <Offices member={m} offices={officesFor(m)} />

  <div class="mx-auto max-w-[1360px] px-4 lg:px-10 py-10 grid grid-cols-1 lg:grid-cols-[minmax(0,2fr)_minmax(0,1fr)] gap-8 lg:gap-12">
    <div class="flex flex-col gap-10">
      {goals.length === 0 && (
        <section class="card p-5">
          <p class="label-code">Open decisions</p>
          <h2 class="headline-md mt-1">No open decision</h2>
          <p class="mt-2 max-w-2xl">No active goal targets this office right now. The contact details above stay current; check <a href="/goals" class="underline">all goals</a> for what is moving.</p>
        </section>
      )}
      {goals.map(({ goal, action, position, flags }) => (
        <section class="card p-5 lg:p-6" aria-labelledby={`g-${goal.slug}`}>
          <p class="label-code">Where they stand</p>
          <h2 id={`g-${goal.slug}`} class="headline-lg mt-1"><a href={`/goals/${goal.slug}`} class="hover:underline">{goal.title}</a></h2>
          <p class="mt-4 flex flex-wrap items-center gap-2">
            <span class={`chip border-ink ${POS[position?.position ?? 'unknown']}`}>{position?.position ?? 'unknown'}</span>
            {position
              ? <span class="text-sm"><a href={position.source_url} rel="noopener" class="underline">Source</a> · {fmtDate(position.source_date)}</span>
              : <span class="text-sm text-ink/70">No sourced statement yet.</span>}
          </p>
          <ul class="mt-3 text-sm flex flex-col gap-1">
            {flags.length === 0 ? <li class="text-ink/70">No recorded vote yet</li> : flags.map((f) => <li>{f}</li>)}
          </ul>
          <p class="mt-4 text-sm text-ink/70" data-report={goal.slug} hidden></p>
          <Counts client:load goal={goal.slug} state={m.state} district={m.chamber === 'house' ? m.district : null} />
          {action && (
            <div class="mt-5 flex flex-col sm:flex-row sm:items-center gap-3">
              <p class="flex-1 font-semibold">{action.ask_text}</p>
              <a href={`/goals/${goal.slug}/act/${action.slug}?target=${m.bioguide_id}`} class="btn btn-primary shrink-0" data-cta>Call →</a>
            </div>
          )}
        </section>
      ))}
      <Visits client:load member={m.bioguide_id} name={m.name} city={m.district_office_city} siteKey={siteKey} partner={partner} />
    </div>
    <aside class="flex flex-col gap-6">
      {goals.map(({ goal }) => <p><a href={`/goals/${goal.slug}/whip`} class="btn btn-ghost">Where everyone stands on this →</a></p>)}
      <p class="text-sm text-ink/70">Positions come from sourced statements and votes in the public record; a constituent report never changes them.</p>
      <p><a href="/goals" class="label-code underline underline-offset-4">All goals →</a></p>
    </aside>
  </div>
  <script is:inline>
    (function () {
      var root = document.querySelector('[data-member]');
      if (!root) return;
      try {
        var p = JSON.parse(localStorage.getItem('cut-ties:place') || 'null');
        if (p && p.state === root.dataset.state && (root.dataset.chamber === 'senate' || String(p.district) === root.dataset.district)) {
          document.querySelectorAll('[data-yours]').forEach(function (e) { e.classList.remove('hidden'); });
          document.querySelectorAll('[data-cta]').forEach(function (e) { e.textContent = 'Call now →'; });
        }
      } catch (e) {}
      var id = location.pathname.split('/').filter(Boolean).pop();
      document.querySelectorAll('[data-report]').forEach(function (el) {
        fetch('/api/members/' + encodeURIComponent(id) + '/reports?goal=' + encodeURIComponent(el.dataset.report))
          .then(function (r) { return r.ok ? r.json() : null; })
          .then(function (b) {
            var l = b && b.latest;
            if (!l) return;
            var words = { will_support: 'office said they will support', undecided: 'office said they are undecided', opposed: 'office said they are opposed', no_answer: 'no answer from the office', other: 'office response' };
            el.textContent = 'Latest call: ' + (words[l.outcome] || l.outcome) + (l.note ? ' — "' + l.note + '"' : '') + ' (' + l.created_at.slice(0, 10) + '; reported by a constituent, unverified)';
            el.hidden = false;
          })
          .catch(function () {});
      });
    })();
  </script>
</Base>
