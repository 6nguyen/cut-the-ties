# Every variable and secret the app reads, one block each: WHERE it is set and WHAT breaks
# without it. Copy nothing blindly: local dev needs none of these (defaults below).
# Bindings that are not env vars: DB (D1, worker/wrangler.jsonc) and DIGEST_MAIL (Email Routing).
# Test: worker/test/env-example.test.ts keeps this file and the code in step.

# ---- Pages build env (GitHub Actions variables, passed to `astro build` by deploy.yml; export
# ---- locally to mirror production) -------------------------------------------------------------
# Deployed origin for absolute share-image URLs. Without it: og:image URLs are relative and previews break.
SITE_URL=https://example.org
# JSON map of the three Stripe payment links {"once_5":"https://buy.stripe.com/...","monthly_1":"...","custom":"..."}. Without it: "link not configured".
STRIPE_LINKS={}
# Turnstile site key (public). Without it: no widget renders and, once TURNSTILE_SECRET is set, every /api/route is refused.
PUBLIC_TURNSTILE_SITE_KEY=
# Address-suggestion provider: geoapify | mapbox (GitHub Actions variable). Without it: the landing field is plain text, no suggestions.
PUBLIC_SUGGEST_PROVIDER=
# That provider's browser API key (GitHub Actions secret; it is baked into the bundle, so restrict it to the site's domain in the provider console). Without it: the build warns and suggestions stay off.
PUBLIC_SUGGEST_TOKEN=
# Dev proxy target for /api/* (web/astro.config.mjs) and, as a Pages PREVIEW environment variable, the
# Worker URL web/functions/api/[[path]].ts proxies to. Without it: dev uses http://localhost:8787; previews answer 503 on /api/*.
API_ORIGIN=http://localhost:8787

# ---- Worker vars (worker/wrangler.jsonc `vars`, edited in git) ---------------------------------
# Hard ceiling on personalised documents per UTC day; the day's cap is derived from the budget below. Without it: the code default (500).
MAX_GENERATIONS_PER_DAY=500
# Monthly LLM budget in USD that sets the daily cap (generation-cost §1); 0 = standard scripts only. Without it: the code default (15).
LLM_MONTHLY_BUDGET_USD=15
# Sender address on the zone; its domain is also the origin of the digest's approve/reject links. Without it: Email Routing rejects the digest.
DIGEST_FROM=digest@cutthetiesmovement.org
# Geocoder override (tests only). Without it: the Census geocoder.
GEOCODER_URL=
# Census Geocoder vintage: ACS2025_Current answers with the 119th map (sitting members); Current_Current with the 120th. Flipped on 2027-01-03. Without it: the code default (ACS2025_Current).
DISTRICT_VINTAGE=ACS2025_Current
# district-counters: /api/counts returns any bucket below this as 0. Without it: the code default (5).
COUNT_THRESHOLD=5
# District-office visit listings; "0" pauses them (POST routes 503, lists empty). Without it: on.
VISITS_ENABLED=1

# ---- Worker secrets (`wrangler secret put <NAME>` in worker/) -----------------------------------
# Turnstile secret. Without it: /api/route skips the Turnstile check (local dev only; never unset in production).
TURNSTILE_SECRET=
# Anthropic key for /api/generate. Without it: generation answers 503 and the digest sends no summary.
ANTHROPIC_API_KEY=
# Daily salt mixed into receipts.ip_hash (SHA-256 of IP, salt and UTC date). Without it: the hash rotates on the date only and the Worker logs a warning once per isolate.
IP_SALT=
# Signs the digest's approve/reject links for visit listings. Without it: the digest lists pending visits with no links and /api/visits/review answers 503.
VISITS_REVIEW_SECRET=
# Verified Email Routing destination for the digest; a secret so the address stays out of this public repo. Without it: the digest cron logs and exits.
MAINTAINER_EMAIL=

# ---- GitHub Actions secrets (repo Settings → Secrets, read by .github/workflows/deploy.yml) ------
# API token with Workers Scripts:Edit, D1:Edit, Pages:Edit, Workers Routes:Edit. Without it: every deploy step fails.
CLOUDFLARE_API_TOKEN=
# Account id (dashboard → Workers & Pages → Overview). Without it: wrangler cannot pick the account.
CLOUDFLARE_ACCOUNT_ID=
# Id `wrangler d1 create cut_ties` printed; rendered into worker/wrangler.deploy.json at deploy time. Without it: deploy-worker and seed-remote stop before touching Cloudflare.
D1_DATABASE_ID=

# ---- GitHub Actions variables (repo Settings → Variables) ---------------------------------------
# Apex domain (no scheme). Sets SITE_URL=https://<SITE_DOMAIN> and the Worker route <SITE_DOMAIN>/api/*. Without it: the Worker serves on workers.dev only and the site has no absolute URLs.
SITE_DOMAIN=
# Pages project name. Without it: cut-ties.
PAGES_PROJECT=cut-ties
